# =========================================================
# FinTrustX — Environment Variables Template
# =========================================================
# Copy this file to .env and configure your environment-specific settings.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_STATE=42

# API Security
FINTRUSTX_API_KEY=dev_api_key_123

# Paths (Optional overrides; defaults are resolved relative to project root)
# DATA_DIR=/path/to/data
# MODEL_DIR=/path/to/models
# REPORT_DIR=/path/to/reports

# API Server Settings (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# MLflow Tracking (Optional)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=fintrustx-credit-risk
