# =========================================================
# FinTrustX — Git Ignore Configuration
# =========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.secrets

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
.pytest_cache/
.coverage
htmlcov/

# Heavy Raw Datasets (>100MB - Download from Kaggle or external cloud storage)
data/raw/*.csv
data/raw/*.zip
data/raw/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Oversized Local Model Files (>100MB - exceed GitHub file limit)
models/*_baseline.joblib
models/*_baseline.pkl

# Experiment Tracking & Local DBs
mlruns/
studies/*.db
*.sqlite